# GeoResponse live wiring
# Copy to .env and fill the values you actually have. Never commit .env.

# auto | production (production requires the required checks in `georesponse doctor`)
GEORESPONSE_MODE=auto
GEORESPONSE_TENANT=demo

# ---------------------------------------------------------------- agent / LLM
# OpenAI-compatible or openjiuwen. For openjiuwen use provider DeepSeek/OpenAI.
GEORESPONSE_AGENT_BACKEND=openai
GEORESPONSE_LLM_API_KEY=
GEORESPONSE_LLM_BASE_URL=https://api.deepseek.com
GEORESPONSE_LLM_MODEL=deepseek-v4-pro
GEORESPONSE_LLM_PROVIDER=OpenAI
GEORESPONSE_LLM_TEMPERATURE=0.2
GEORESPONSE_LLM_TIMEOUT=60

# ---------------------------------------------------------------- inference
GEORESPONSE_ONNX_MODEL=models/damage-head.onnx
GEORESPONSE_ONNX_PROVIDERS=auto
GEORESPONSE_ONNX_BATCH=8
# CANNExecutionProvider,OpenVINOExecutionProvider,QNNExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider

# ---------------------------------------------------------------- imagery
GEORESPONSE_STAC_URL=https://earth-search.aws.element84.com/v1
GEORESPONSE_STAC_COLLECTION=sentinel-2-l2a
GEORESPONSE_MAX_CLOUD=30
GEORESPONSE_IMAGERY_CACHE=runtime/imagery
PLANET_API_KEY=
MAXAR_API_KEY=
AIRBUS_API_KEY=
GEORESPONSE_SFTP_HOST=
GEORESPONSE_SFTP_USER=
GEORESPONSE_SFTP_PASSWORD=

# ---------------------------------------------------------------- notifications
GEORESPONSE_SMTP_HOST=
GEORESPONSE_SMTP_PORT=587
GEORESPONSE_SMTP_USER=
GEORESPONSE_SMTP_PASSWORD=
GEORESPONSE_SMTP_FROM=georesponse@example.com
GEORESPONSE_SMTP_TLS=true
GEORESPONSE_SLACK_WEBHOOK=
GEORESPONSE_TEAMS_WEBHOOK=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PAGERDUTY_ROUTING_KEY=
GEORESPONSE_WEBHOOK_URL=

# ---------------------------------------------------------------- integrations
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=GEO
SERVICENOW_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
GUIDEWIRE_URL=
GUIDEWIRE_TOKEN=
DUCK_CREEK_URL=
DUCK_CREEK_TOKEN=
MAXIMO_URL=
MAXIMO_TOKEN=
SAP_URL=
SAP_USER=
SAP_PASSWORD=
ARCGIS_URL=
ARCGIS_TOKEN=
SIEM_HEC_URL=
SIEM_HEC_TOKEN=

# ---------------------------------------------------------------- platform
GEORESPONSE_POSTGRES_DSN=postgresql://georesponse:georesponse@localhost:5432/georesponse
GEORESPONSE_REDIS_URL=redis://localhost:6379/0
GEORESPONSE_S3_ENDPOINT=http://localhost:9000
GEORESPONSE_S3_BUCKET=georesponse
GEORESPONSE_S3_ACCESS_KEY=minioadmin
GEORESPONSE_S3_SECRET_KEY=minioadmin
GEORESPONSE_AUTH_MODE=api-key
GEORESPONSE_API_KEY=
GEORESPONSE_OIDC_ISSUER=
GEORESPONSE_OIDC_AUDIENCE=
