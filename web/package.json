{
  "name": "georesponse-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "budget": "node scripts/check-budget.mjs",
    "test": "vitest run",
    "e2e": "playwright test e2e/shell.spec.ts --project=chromium",
    "e2e:visual": "playwright test e2e/visual.spec.ts",
    "e2e:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "verify": "npm run test && npm run lint:design && npm run build && npm run budget && npm run e2e -- --project=chromium",
    "lint:design": "node scripts/lint-design.mjs",
    "lint:design:update": "node scripts/lint-design.mjs --update",
    "e2e:all": "playwright test e2e/shell.spec.ts"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
